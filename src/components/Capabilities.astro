const capabilities = [
  {
    number: "01",
    title: "Original products",
    copy: "We identify overlooked problems and create our own products, from the first technical experiment to a usable system.",
    tags: ["Product invention", "Prototyping", "Venture building"]
  },
  {
    number: "02",
    title: "Software & AI",
    copy: "Applied AI, private intelligence, SaaS platforms and custom digital systems engineered around real workflows.",
    tags: ["Applied AI", "Custom software", "SaaS platforms"]
  },
  {
    number: "03",
