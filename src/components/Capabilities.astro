---

<section class="capabilities section" id="capabilities" aria-labelledby="capabilities-title">
  <div class="capabilities-intro">
    <p class="eyebrow"><span></span> What we do</p>
    <h2 id="capabilities-title">Research the unknown.<br /><em>Engineer the possible.</em></h2>
  </div>

  <div class="capability-list">
    {capabilities.map((capability) => (
      <article class="capability-card">
        <div class="capability-top">
          <span>{capability.number}</span>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 25 25 7M12 7h13v13" /></svg>
        </div>
        <h3>{capability.title}</h3>
        <p>{capability.copy}</p>
        <ul aria-label={`${capability.title} areas`}>
          {capability.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
