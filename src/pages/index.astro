---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ResearchToReach from "../components/ResearchToReach.astro";
import Capabilities from "../components/Capabilities.astro";
import VentureShowcase from "../components/VentureShowcase.astro";
import SapakiSection from "../components/SapakiSection.astro";
import CompanyNetwork from "../components/CompanyNetwork.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import { company } from "../data/company";

const title = "HawkFranklin — Innovation & technology";
const description =
  "HawkFranklin is an innovation and technology company building original software, applied AI and connected products.";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: company.name,
  alternateName: "HawkFranklin",
  url: company.siteUrl,
  logo: `${company.siteUrl}/brand/hawkfranklin-emblem.png`,
  identifier: company.registryCode,
  email: company.email,
  telephone: company.phone,
  sameAs: [company.registryUrl],
  address: {
    "@type": "PostalAddress",
    streetAddress: company.streetAddress,
    postalCode: company.postalCode,
    addressLocality: company.city,
    addressCountry: company.countryCode
  }
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <Header />
  <main id="main-content">
    <Hero />
    <ResearchToReach />
    <Capabilities />
    <VentureShowcase />
    <SapakiSection />
    <CompanyNetwork />
    <ContactCTA />
  </main>
  <Footer />
  <div class="scroll-meter" aria-hidden="true"><span data-scroll-meter></span></div>
  <script>
    import "../scripts/shell";
  </script>
  <script>
    import "../scripts/motion";
  </script>
</BaseLayout>
