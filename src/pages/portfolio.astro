---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PelliscopeChapter from "../components/portfolio/PelliscopeChapter.astro";
import AclisBand from "../components/portfolio/AclisBand.astro";
import OncoGemmaChapter from "../components/portfolio/OncoGemmaChapter.astro";
import AuraChapter from "../components/portfolio/AuraChapter.astro";
import ResearchChapter from "../components/portfolio/ResearchChapter.astro";
import ProbxChapter from "../components/portfolio/ProbxChapter.astro";
import SapakiChapter from "../components/portfolio/SapakiChapter.astro";
import { networkChips } from "../data/portfolio";
import "../styles/portfolio.css";

const title = "Portfolio — HawkFranklin";
const description =
  "The ventures, research and platforms HawkFranklin is building — from clinical AI and on-device intelligence to robotics distribution.";

const totalChapters = 6;

const railStops = [
  { id: "pelliscope", label: "01 · PelliScope" },
  { id: "aclis", label: "· ACLIS" },
  { id: "oncogemma", label: "02 · OncoGemma" },
  { id: "aura", label: "03 · AURA" },
  { id: "research", label: "04 · ML Copilot" },
  { id: "probx", label: "05 · ProbX News" },
  { id: "sapaki", label: "06 · Sapaki" }
];
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <section class="p-hero">
      <div class="p-hero-glow" aria-hidden="true"></div>
      <div class="p-hero-inner">
        <p class="eyebrow"><span></span> Portfolio</p>
        <h1>Everything we are <em>building, right now.</em></h1>
        <p class="p-hero-lede">
          Six ventures, one platform layer, one network. Scroll through the clinical AI in pilot, the research
          under peer review, and the robots already competing on a field — each with the media to prove it is real.
        </p>
        <nav class="p-hero-rail" aria-label="Jump to venture">
          {railStops.map((stop) => (
            <button type="button" data-rail-target={stop.id}>{stop.label}</button>
          ))}
        </nav>
      </div>
    </section>

    <div class="p-chapters">
      <PelliscopeChapter total={totalChapters} />
      <AclisBand />
      <OncoGemmaChapter total={totalChapters} />
      <AuraChapter total={totalChapters} />
      <ResearchChapter total={totalChapters} />
      <ProbxChapter total={totalChapters} />
      <SapakiChapter total={totalChapters} />
    </div>

    <section class="p-network section" aria-labelledby="network-strip-title">
      <p class="eyebrow"><span></span> Also in the network</p>
      <h2 id="network-strip-title" style="font-size:clamp(2.2rem,4vw,3.4rem);font-weight:500;letter-spacing:-0.05em;margin-bottom:2rem;">
        Beyond the flagships.
      </h2>
      <div class="p-network-grid">
        {networkChips.map((chip) => {
          const Tag = chip.href ? "a" : "div";
          return (
            <Tag class="p-network-card" href={chip.href} target={chip.href ? "_blank" : undefined} rel={chip.href ? "noopener" : undefined}>
              <div class="p-network-mark">
                {chip.logo ? <img src={chip.logo} alt={`${chip.name} logo`} /> : <span>{chip.name.slice(0, 2).toUpperCase()}</span>}
              </div>
              <h3>{chip.name}</h3>
              <p>{chip.blurb}</p>
              {chip.href && <span class="p-network-link">Visit ↗</span>}
            </Tag>
          );
        })}
      </div>
    </section>

    <ContactCTA />
  </main>
  <Footer />

  <nav class="p-rail-nav" aria-label="Chapter navigation">
    {railStops.map((stop) => (
      <button type="button" data-rail-target={stop.id} data-label={stop.label.replace(/^\S+\s·\s/, "")} aria-label={`Jump to ${stop.label}`}></button>
    ))}
  </nav>

  <div class="p-modal" data-video-modal>
    <div class="p-modal-frame">
      <button type="button" class="p-modal-close" data-modal-close>Close ✕</button>
      <video playsinline controls></video>
    </div>
  </div>

  <div class="scroll-meter" aria-hidden="true"><span data-scroll-meter></span></div>
  <script>
    import "../scripts/shell";
  </script>
  <script>
    import "../scripts/portfolio";
  </script>
</BaseLayout>
